+package main
+
+import (
+    "fmt"
+    "io"
+    "log"
+    "net"
+    "os"
+    "time"
+)
+
+func proxy(src net.Conn, dst net.Conn, label string) {
+    defer src.Close()
+    defer dst.Close()
+    buf := make([]byte, 32*1024)
+    var last time.Time
+    for {
+        n, err := src.Read(buf)
+        if n > 0 {
+            if label == "client->server" {
+                if last.IsZero() {
+                    fmt.Printf("%s bytes=%d gap=0\n", label, n)
+                } else {
+                    gap := time.Since(last).Seconds()
+                    fmt.Printf("%s bytes=%d gap=%.6f\n", label, n, gap)
+                }
+                last = time.Now()
+            }
+            if _, err2 := dst.Write(buf[:n]); err2 != nil {
+                return
+            }
+        }
+        if err != nil {
+            if err != io.EOF {
+                log.Println("read error:", err)
+            }
+            return
+        }
+    }
+}
+
+func handleConnection(client net.Conn, destAddr string) {
+    server, err := net.Dial("tcp", destAddr)
+    if err != nil {
+        log.Println("error connecting to", destAddr, ":", err)
+        client.Close()
+        return
+    }
+    go proxy(client, server, "client->server")
+    proxy(server, client, "server->client")
+}
+
+func main() {
+    listenPort := os.Getenv("LISTEN_PORT")
+    if listenPort == "" {
+        listenPort = "9001"
+    }
+    dest := os.Getenv("DEST_ADDR")
+    if dest == "" {
+        dest = "localhost:80"
+    }
+    ln, err := net.Listen("tcp", ":"+listenPort)
+    if err != nil {
+        log.Fatal(err)
+    }
+    log.Printf("relay listening on :%s forwarding to %s\n", listenPort, dest)
+    for {
+        conn, err := ln.Accept()
+        if err != nil {
+            log.Println(err)
+            continue
+        }
+        go handleConnection(conn, dest)
+    }
+}
+
