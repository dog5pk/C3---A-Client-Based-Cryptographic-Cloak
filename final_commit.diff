+#!/usr/bin/env python3
+"""
+analyzer.py
+
+Parse relay logs produced by the C³ relays and print concise packet-size
+and inter-packet-gap statistics.
+"""
+from __future__ import annotations
+
+import argparse
+import re
+import sys
+import math
+try:
+    import numpy as np
+except Exception:
+    np = None
+
+LINE_RE = re.compile(r"client->server\s+bytes=(\d+)\s+gap=([0-9eE\+\-\.]+)")
+
+def parse_lines(lines):
+    sizes = []
+    gaps = []
+    for ln in lines:
+        m = LINE_RE.search(ln)
+        if not m:
+            continue
+        try:
+            size = int(m.group(1))
+            gap_s = float(m.group(2))
+        except Exception:
+            continue
+        sizes.append(size)
+        gaps.append(gap_s)
+    return sizes, gaps
+
+def mean_std_median(values):
+    if not values:
+        return None, None, None
+    if np is not None:
+        arr = np.array(values, dtype=float)
+        mean = float(arr.mean())
+        std = float(arr.std(ddof=0))
+        median = float(np.median(arr))
+    else:
+        n = len(values)
+        mean = sum(values) / n
+        std = math.sqrt(sum((x - mean) ** 2 for x in values) / n)
+        sortedv = sorted(values)
+        mid = n // 2
+        if n % 2 == 1:
+            median = float(sortedv[mid])
+        else:
+            median = (sortedv[mid - 1] + sortedv[mid]) / 2.0
+    return mean, std, median
+
+def human_readable_report(sizes, gaps_s):
+    total_writes = len(sizes)
+    total_bytes = sum(sizes)
+    mean_size, std_size, median_size = mean_std_median([float(s) for s in sizes]) 
+    gaps_ms = [g * 1000.0 for g in gaps_s] if gaps_s else []
+    mean_gap, std_gap, median_gap = mean_std_median(gaps_ms)
+    lines = []
+    lines.append("=== Relay Log Analysis ===")
+    lines.append(f"Total writes (client->server): {total_writes}")
+    lines.append(f"Total bytes written: {total_bytes}")
+    if mean_size is not None:
+        lines.append(f"Packet sizes (bytes): mean={mean_size:.2f}, median={median_size:.2f}, std={std_size:.2f}")
+    else:
+        lines.append("Packet sizes: n/a")
+    if gaps_ms:
+        lines.append(f"Inter-packet gaps (ms): mean={mean_gap:.3f}, median={median_gap:.3f}, std={std_gap:.3f}")
+        lines.append(f"Observed gaps count: {len(gaps_ms)} (first gap is 0 for initial write)")
+    else:
+        lines.append("Inter-packet gaps: n/a (single-segment writes only)")
+    return "\n".join(lines)
+
+def main():
+    p = argparse.ArgumentParser()
+    p.add_argument("logfile")
+    args = p.parse_args()
+    if args.logfile == "-":
+        content = sys.stdin.read().splitlines()
+    else:
+        try:
+            with open(args.logfile, "r", encoding="utf-8") as f:
+                content = f.read().splitlines()
+        except Exception as e:
+            print(f"[error] failed to open {args.logfile}: {e}", file=sys.stderr)
+            sys.exit(2)
+    sizes, gaps = parse_lines(content)
+    report = human_readable_report(sizes, gaps)
+    print(report)
+
+if __name__ == "__main__":
+    main()
+
